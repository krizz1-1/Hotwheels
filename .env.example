# ================================================================
# Telegram Bot Configuration
# Get your BOT_TOKEN from @BotFather on Telegram (https://t.me/BotFather)
# Get your CHAT_ID from @userinfobot on Telegram (https://t.me/userinfobot)
# ================================================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ================================================================
# Blinkit Target Location (Hyperlocal)
# Blinkit dark stores stock different items per location.
# Set your PIN code and Lat/Long coordinates.
# You can find exact Lat/Long from Google Maps by right-clicking your location.
# ================================================================
TARGET_PINCODE=110001
TARGET_LAT=28.6139
TARGET_LON=77.2090
TARGET_LOCALITY=Connaught Place, New Delhi

# ================================================================
# Tracking Settings
# SEARCH_QUERY: Search term on Blinkit (e.g. "hot wheels" or "hot wheels mainline")
# CHECK_INTERVAL_SECONDS: How often to scan (in seconds). Default 30s.
# HEADLESS: true (run silently in background) or false (show browser window)
# TARGET_PRODUCT_URLS: Optional comma-separated specific Hot Wheels URLs to monitor
# ================================================================
SEARCH_QUERY=hot wheels
CHECK_INTERVAL_SECONDS=30
HEADLESS=true
TARGET_PRODUCT_URLS=https://blinkit.com/prid/601140

